    {
      "headline": "How NetSuite Consultants Can Help Retailers Navigate the NetSuite POS & SCIS Sunset",
      "url": "https://www.lightspeedhq.com/blog/how-netsuite-consultants-can-help-retailers-navigate-the-netsuite-pos-scis-sunset/",
